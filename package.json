{
  "name": "zine-ify",
  "version": "2.0.0",
  "description": "A modern web application to convert PDFs into printable 8-page zine layouts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --host 0.0.0.0 --port 8001",
    "serve:test": "vite preview --port 8001 --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint src/services/PDFProcessor.js",
    "lint:fix": "eslint src/services/PDFProcessor.js --fix",
    "generate:pwa-icons": "node scripts/generate_pwa_icons.js"
  },
  "dependencies": {
    "@khmyznikov/pwa-install": "^0.6.3",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.9",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "lucide": "^1.14.0",
    "mitt": "^3.0.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "10.3.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "vite": "8.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "lockfileVersion": "6.0",
    "overrides": {
      "ajv": "6.14.0",
      "brace-expansion": "5.0.5",
      "dompurify": "3.3.2",
      "flatted": "3.4.2",
      "minimatch": "10.2.3",
      "picomatch": "4.0.4",
      "rollup": "4.59.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js"
    ]
  },
  "keywords": [
    "pdf",
    "zine",
    "print",
    "webapp",
    "pwa"
  ],
  "author": "Octovo Zine Maker Team",
  "license": "MIT"
}
