{
  "name": "zine-ify",
  "version": "2.0.0",
  "description": "A modern web application to convert PDFs into printable 8-page zine layouts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --host 0.0.0.0 --port 8001",
    "serve:test": "vite preview --port 8001 --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "lucide": "^0.562.0",
    "mitt": "^3.0.1",
    "pdfjs-dist": "^5.4.530",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "eslint": "10.2.0",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "vite": "7.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "ajv": "6.14.0",
      "brace-expansion": "5.0.5",
      "dompurify": "3.3.2",
      "flatted": "3.4.2",
      "minimatch": "10.2.3",
      "picomatch": "4.0.4",
      "rollup": "4.59.0"
    },
    "onlyBuiltDependencies": ["esbuild", "core-js"]
  },
  "keywords": [
    "pdf",
    "zine",
    "print",
    "webapp",
    "pwa"
  ],
  "author": "Octovo Zine Maker Team",
  "license": "MIT"
}
